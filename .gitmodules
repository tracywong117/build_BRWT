[submodule "metagraph/external-libraries/eigen"]
	path = metagraph/external-libraries/eigen
	url = https://github.com/eigenteam/eigen-git-mirror.git
[submodule "metagraph/external-libraries/asio"]
	path = metagraph/external-libraries/asio
	url = https://github.com/chriskohlhoff/asio.git
[submodule "metagraph/external-libraries/jsoncpp"]
	path = metagraph/external-libraries/jsoncpp
	url = https://github.com/open-source-parsers/jsoncpp.git
[submodule "metagraph/external-libraries/cpp_progress_bar"]
	path = metagraph/external-libraries/cpp_progress_bar
	url = https://github.com/karasikov/cpp_progress_bar
[submodule "metagraph/external-libraries/DYNAMIC"]
	path = metagraph/external-libraries/DYNAMIC
